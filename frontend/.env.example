# Base URL of the Chess Review backend API.
# Local development: leave this unset so Vite proxies /api to localhost:8010.
# Vercel + Railway: set this in Vercel Project Settings > Environment Variables
# to the *public* Railway domain, for example:
VITE_API_URL=https://analystchessbychai-production.up.railway.app/api
# Never use a *.railway.internal URL here: it is private to Railway and a
# visitor's browser on Vercel cannot reach it.
# VITE_API_URL=
