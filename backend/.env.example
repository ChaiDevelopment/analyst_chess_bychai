# Optional: enables AI-generated human explanations for mistakes/blunders/brilliant moves.
# If left empty, the app falls back to template-based explanations built from engine data.
OPENAI_API_KEY=

# Path to the Stockfish executable. Leave blank to search PATH automatically.
# Windows example: STOCKFISH_PATH=C:\\tools\\stockfish\\stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=D:\stockfish

# Search depth used for every position analysed. Higher = stronger & slower.
# Lower this if analysis is too slow on your machine.
ANALYSIS_DEPTH=16

# Max number of plies (half-moves) accepted in a single PGN, to bound analysis time.
MAX_PLIES=300

# Allowed origins for CORS, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
